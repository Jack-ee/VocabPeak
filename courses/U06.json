","pos":"n.","zh":"风景; 风景画","sent":"U06-P3-S3","phrases":[{"en":"paint landscapes","zh":"画风景"}]},{"id":"U06-W27","lemma":"muscle","surface":"muscle","pos":"n.","zh":"肌肉","sent":"U06-P3-S4","phrases":[{"en":"muscle memory","zh":"肌肉记忆"},{"en":"build muscle","zh":"锻炼肌肉"}]},{"id":"U06-W28","lemma":"repetition","surface":"repetition","pos":"n.","zh":"重复; 反复","sent":"U06-P3-S4","phrases":[{"en":"comes with repetition","zh":"通过反复练习获得"}]},{"id":"U06-W29","lemma":"continually","surface":"Continually","pos":"adv.","zh":"不断地; 持续地","sent":"U06-P4-S1","phrases":[{"en":"continually challenge","zh":"不断挑战"}]},{"id":"U06-W30","lemma":"challenge","surface":"challenge","pos":"n. / v.","zh":"n. 挑战 v. 挑战; 质疑","sent":"U06-P4-S1","phrases":[{"en":"take on challenges","zh":"接受挑战"},{"en":"face a challenge","zh":"面对挑战"}]},{"id":"U06-W31","lemma":"comfort zone","surface":"comfort zone","pos":"phr.","zh":"舒适区","sent":"U06-P4-S2","phrases":[{"en":"get out of one's comfort zone","zh":"走出舒适区"}]},{"id":"U06-W32","lemma":"artistic","surface":"Artistic","pos":"adj.","zh":"艺术的; 有艺术性的","sent":"U06-P4-S3","phrases":[{"en":"artistic growth","zh":"艺术成长"},{"en":"artistic ability","zh":"艺术能力"}]},{"id":"U06-W33","lemma":"a bit","surface":"a bit","pos":"phr.","zh":"有点; 稍微","sent":"U06-P4-S3","phrases":[{"en":"a bit painful","zh":"有点痛苦"},{"en":"a bit of","zh":"一点..."}]},{"id":"U06-W34","lemma":"painful","surface":"painful","pos":"adj.","zh":"痛苦的; 疼痛的","sent":"U06-P4-S3","phrases":[{"en":"painful experience","zh":"痛苦的经历"}]},{"id":"U06-W35","lemma":"take on","surface":"taking on","pos":"phr. v.","zh":"承担; 接受; 呈现","sent":"U06-P4-S5","phrases":[{"en":"take on challenges","zh":"接受挑战"},{"en":"take on responsibility","zh":"承担责任"}]},{"id":"U06-W36","lemma":"take up","surface":"took up","pos":"phr. v.","zh":"开始从事; 接受; 占据","sent":"U06-P4-S6","phrases":[{"en":"take up a challenge","zh":"接受挑战"},{"en":"take up a hobby","zh":"开始一项爱好"}]},{"id":"U06-W37","lemma":"post","surface":"post","pos":"v. / n.","zh":"v. 发布; 张贴 n. 帖子; 职位","sent":"U06-P4-S6","phrases":[{"en":"post online","zh":"发布到网上"},{"en":"social media post","zh":"社交媒体帖子"}]},{"id":"U06-W38","lemma":"seek","surface":"Seeking","pos":"v.","zh":"寻求; 寻找","sent":"U06-P5-S2","phrases":[{"en":"seek feedback","zh":"寻求反馈"},{"en":"seek help","zh":"寻求帮助"}]},{"id":"U06-W39","lemma":"accept","surface":"accepting","pos":"v.","zh":"接受; 认可","sent":"U06-P5-S2","phrases":[{"en":"accept feedback","zh":"接受反馈"}]},{"id":"U06-W40","lemma":"constructive","surface":"constructive","pos":"adj.","zh":"建设性的; 有助益的","sent":"U06-P5-S2","phrases":[{"en":"constructive feedback","zh":"建设性的反馈"}]},{"id":"U06-W41","lemma":"feedback","surface":"feedback","pos":"n.","zh":"反馈; 回馈","sent":"U06-P5-S2","phrases":[{"en":"give feedback","zh":"给予反馈"},{"en":"positive feedback","zh":"积极的反馈"}]},{"id":"U06-W42","lemma":"crucial","surface":"crucial","pos":"adj.","zh":"至关重要的; 关键的","sent":"U06-P5-S2","phrases":[{"en":"be crucial to","zh":"对...至关重要"},{"en":"crucial moment","zh":"关键时刻"}]},{"id":"U06-W43","lemma":"in turn","surface":"in turn","pos":"phr.","zh":"反过来; 依次; 轮流","sent":"U06-P5-S3","phrases":[{"en":"in turn","zh":"作为回报; 反过来"}]},{"id":"U06-W44","lemma":"value","surface":"valued","pos":"v. / adj.","zh":"v. 重视; 珍视 adj. 受重视的","sent":"U06-P5-S4","phrases":[{"en":"feel valued","zh":"感到被重视"}]},{"id":"U06-W45","lemma":"respect","surface":"respected","pos":"v. / adj.","zh":"v. 尊重 adj. 受尊重的","sent":"U06-P5-S4","phrases":[{"en":"feel respected","zh":"感到受尊重"},{"en":"show respect for","zh":"对...表示尊重"}]},{"id":"U06-W46","lemma":"straight","surface":"straight","pos":"adj. / adv.","zh":"adj. 直的; 笔直的 adv. 直接地","sent":"U06-P6-S1","phrases":[{"en":"straight path","zh":"笔直的道路"},{"en":"straight ahead","zh":"直走"}]},{"id":"U06-W47","lemma":"roadblock","surface":"roadblocks","pos":"n.","zh":"障碍; 路障","sent":"U06-P6-S2","phrases":[{"en":"hit roadblocks","zh":"遇到障碍"}]},{"id":"U06-W48","lemma":"discourage","surface":"discouraged","pos":"v.","zh":"使气馁; 使灰心","sent":"U06-P6-S2","phrases":[{"en":"feel discouraged","zh":"感到气馁"},{"en":"discourage sb. from doing","zh":"阻止某人做某事"}]},{"id":"U06-W49","lemma":"put in","surface":"put in","pos":"phr. v.","zh":"投入; 花费; 安装","sent":"U06-P3-S2","phrases":[{"en":"put in effort","zh":"付出努力"},{"en":"put in time","zh":"投入时间"}]},{"id":"U06-W50","lemma":"effort","surface":"effort","pos":"n.","zh":"努力; 尝试","sent":"U06-P6-S3","phrases":[{"en":"put in effort","zh":"付出努力"},{"en":"make an effort","zh":"努力"}]},{"id":"U06-W51","lemma":"harvest","surface":"harvest","pos":"v. / n.","zh":"v. 收获; 收割 n. 收获; 收成","sent":"U06-P6-S4","phrases":[{"en":"harvest rewards","zh":"收获回报"},{"en":"harvest season","zh":"收获季节"}]},{"id":"U06-W52","lemma":"reward","surface":"rewards","pos":"n.","zh":"回报; 奖励; 报酬","sent":"U06-P6-S4","phrases":[{"en":"harvest the rewards","zh":"收获回报"},{"en":"as a reward","zh":"作为奖励"}]}],"_v":1786413566727}