lemma":"gardening","surface":"gardening","pos":"n.","zh":"园艺; 园艺学","sent":"U03-P5-S2","phrases":[{"en":"get interested in gardening","zh":"对园艺产生兴趣"},{"en":"do some gardening","zh":"做些园艺活儿"}]},{"id":"U03-W47","lemma":"besides","surface":"Besides","pos":"adv. / prep.","zh":"adv. 此外; 而且 prep. 除……之外(还)","sent":"U03-P5-S3","phrases":[{"en":"besides, working in the garden","zh":"此外，在菜园里劳动"},{"en":"besides doing sth","zh":"除了做某事之外"}]},{"id":"U03-W48","lemma":"education","surface":"education","pos":"n.","zh":"教育; 培养","sent":"U03-P5-S3","phrases":[{"en":"special education students","zh":"特殊教育学生"},{"en":"receive a good education","zh":"接受良好的教育"}]},{"id":"U03-W49","lemma":"emotional","surface":"emotional","pos":"adj.","zh":"情感的; 情绪的; 易动感情的","sent":"U03-P5-S3","phrases":[{"en":"emotional control issues","zh":"情绪控制问题"},{"en":"emotional support","zh":"情感支持"}]},{"id":"U03-W50","lemma":"control","surface":"control","pos":"n. / v.","zh":"n. 控制; 管理 v. 控制; 支配","sent":"U03-P5-S3","phrases":[{"en":"emotional control","zh":"情绪控制"},{"en":"under control","zh":"在控制之中"},{"en":"lose control of","zh":"失去对……的控制"}]},{"id":"U03-W51","lemma":"issue","surface":"issues","pos":"n. / v.","zh":"n. 问题; 议题; 期号 v. 发布; 发行","sent":"U03-P5-S3","phrases":[{"en":"have emotional control issues","zh":"存在情绪控制问题"},{"en":"an important issue","zh":"一个重要问题"}]},{"id":"U03-W52","lemma":"successful","surface":"successful","pos":"adj.","zh":"成功的; 有成就的","sent":"U03-P5-S4","phrases":[{"en":"feel successful","zh":"感到自己是成功的"},{"en":"be successful in doing sth","zh":"成功地做成某事"}]}],"_v":1786413566727}