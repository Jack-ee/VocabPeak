U10-W29","lemma":"comfort","surface":"comfort","pos":"n. / v.","zh":"n. 舒适; 安慰 v. 安慰; 使舒适","sent":"U10-P5-S1","phrases":[{"en":"comfort zone","zh":"舒适区"}]},{"id":"U10-W30","lemma":"zone","surface":"zone","pos":"n.","zh":"区域; 地带","sent":"U10-P5-S2","phrases":[{"en":"comfort zone","zh":"舒适区"},{"en":"time zone","zh":"时区"}]},{"id":"U10-W31","lemma":"impatient","surface":"impatient","pos":"adj.","zh":"不耐烦的; 急躁的","sent":"U10-P5-S2","phrases":[{"en":"get impatient","zh":"变得不耐烦"},{"en":"impatient with","zh":"对...不耐烦"}]},{"id":"U10-W32","lemma":"circumstance","surface":"circumstances","pos":"n.","zh":"情况; 环境; 境遇","sent":"U10-P5-S2","phrases":[{"en":"under the circumstances","zh":"在这种情况下"},{"en":"in no circumstances","zh":"绝不"}]},{"id":"U10-W33","lemma":"merely","surface":"merely","pos":"adv.","zh":"仅仅; 只不过","sent":"U10-P5-S3","phrases":[{"en":"merely uncomfortable","zh":"仅仅是不舒服"}]},{"id":"U10-W34","lemma":"gradually","surface":"gradually","pos":"adv.","zh":"逐渐地; 渐渐地","sent":"U10-P5-S4","phrases":[{"en":"gradually become","zh":"逐渐变得"}]}],"_v":1786413566727}