phrases":[{"en":"acknowledge mistakes","zh":"承认错误"},{"en":"widely acknowledged","zh":"广受认可的"}]},{"id":"U08-W29","lemma":"identify","surface":"identify","pos":"v.","zh":"识别; 确定; 找出","sent":"U08-P3-S4","phrases":[{"en":"identify areas for improvement","zh":"找出需要改进的地方"},{"en":"identify with","zh":"认同; 与...产生共鸣"}]},{"id":"U08-W30","lemma":"appear","surface":"appears","pos":"v.","zh":"似乎; 出现; 显得","sent":"U08-P4-S1","phrases":[{"en":"appear to be","zh":"似乎是..."},{"en":"it appears that","zh":"似乎..."}]},{"id":"U08-W31","lemma":"asset","surface":"asset","pos":"n.","zh":"资产; 优势; 有价值的人或物","sent":"U08-P4-S1","phrases":[{"en":"a huge asset","zh":"巨大的优势"},{"en":"fixed asset","zh":"固定资产"}]},{"id":"U08-W32","lemma":"tend to","surface":"tend to","pos":"phr. v.","zh":"倾向于; 往往会","sent":"U08-P4-S2","phrases":[{"en":"tend to do sth.","zh":"倾向于做某事"}]},{"id":"U08-W33","lemma":"rate","surface":"rate","pos":"v. / n.","zh":"v. 评价; 评级 n. 比率; 速率; 价格","sent":"U08-P2-S3","phrases":[{"en":"rate highly","zh":"高度评价"},{"en":"at any rate","zh":"无论如何"}]},{"id":"U08-W34","lemma":"spouse","surface":"spouse","pos":"n.","zh":"配偶","sent":"U08-P4-S2","phrases":[{"en":"legal spouse","zh":"合法配偶"}]},{"id":"U08-W35","lemma":"be likely to","surface":"is more likely to initiate","pos":"phr.","zh":"可能; 倾向于","sent":"U08-P4-S3","phrases":[{"en":"be more likely to","zh":"更有可能..."},{"en":"be less likely to","zh":"不太可能..."}]},{"id":"U08-W36","lemma":"initiate","surface":"initiate","pos":"v.","zh":"开始; 发起; 开启","sent":"U08-P4-S3","phrases":[{"en":"initiate a relationship","zh":"开启一段关系"},{"en":"initiate a conversation","zh":"发起对话"}]}],"_v":1786413566727}