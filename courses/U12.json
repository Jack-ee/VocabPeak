":[{"en":"exist in","zh":"存在于..."}]},{"id":"U12-W27","lemma":"casual","surface":"casual","pos":"adj.","zh":"随意的; 偶然的; 休闲的","sent":"U12-P3-S1","phrases":[{"en":"casual conversation","zh":"随意的交谈"},{"en":"casual clothes","zh":"休闲装"}]},{"id":"U12-W28","lemma":"grease","surface":"grease","pos":"n. / v.","zh":"n. 润滑剂; 油脂 v. 给...涂油脂","sent":"U12-P3-S2","phrases":[{"en":"the grease for communication","zh":"沟通的润滑剂"}]},{"id":"U12-W29","lemma":"communication","surface":"communication","pos":"n.","zh":"沟通; 交流; 通信","sent":"U12-P3-S2","phrases":[{"en":"social communication","zh":"社会沟通"},{"en":"means of communication","zh":"通信手段"}]},{"id":"U12-W30","lemma":"director","surface":"director","pos":"n.","zh":"主任; 导演; 董事","sent":"U12-P3-S2","phrases":[{"en":"research director","zh":"研究主任"}]},{"id":"U12-W31","lemma":"institute","surface":"Institute","pos":"n.","zh":"研究所; 学院; 学会","sent":"U12-P3-S2","phrases":[{"en":"research institute","zh":"研究机构"}]},{"id":"U12-W32","lemma":"business","surface":"business","pos":"n.","zh":"生意; 商业; 事务","sent":"U12-P3-S3","phrases":[{"en":"business deal","zh":"商业交易"},{"en":"do business","zh":"做生意"}]},{"id":"U12-W33","lemma":"deal","surface":"deal","pos":"n. / v.","zh":"n. 交易; 协议 v. 处理; 分配","sent":"U12-P3-S3","phrases":[{"en":"big deal","zh":"大交易; 大事"},{"en":"deal with","zh":"处理; 应对"}]},{"id":"U12-W34","lemma":"connect","surface":"connect","pos":"v.","zh":"连接; 联系; 建立关系","sent":"U12-P3-S4","phrases":[{"en":"connect with","zh":"与...建立联系"},{"en":"connect to","zh":"连接到..."}]},{"id":"U12-W35","lemma":"communicate","surface":"communicate","pos":"v.","zh":"交流; 沟通; 传达","sent":"U12-P3-S4","phrases":[{"en":"communicate with","zh":"与...交流"},{"en":"communicate effectively","zh":"有效沟通"}]},{"id":"U12-W36","lemma":"associate","surface":"associate","pos":"adj. / v. / n.","zh":"adj. 副的; 联合的 v. 联系; 交往 n. 同事; 伙伴","sent":"U12-P4-S1","phrases":[{"en":"associate professor","zh":"副教授"}]},{"id":"U12-W37","lemma":"professor","surface":"professor","pos":"n.","zh":"教授","sent":"U12-P4-S1","phrases":[{"en":"associate professor","zh":"副教授"}]},{"id":"U12-W38","lemma":"psychology","surface":"psychology","pos":"n.","zh":"心理学","sent":"U12-P4-S1","phrases":[{"en":"professor of psychology","zh":"心理学教授"}]},{"id":"U12-W39","lemma":"seek","surface":"seek","pos":"v.","zh":"寻找; 寻求; 试图","sent":"U12-P4-S2","phrases":[{"en":"seek out","zh":"找出; 寻求"},{"en":"seek help","zh":"寻求帮助"}]},{"id":"U12-W40","lemma":"interaction","surface":"interaction","pos":"n.","zh":"互动; 相互作用","sent":"U12-P4-S2","phrases":[{"en":"social interaction","zh":"社会互动"}]},{"id":"U12-W41","lemma":"waiter","surface":"waiter","pos":"n.","zh":"服务员; 侍者","sent":"U12-P4-S2","phrases":[{"en":"interact with the waiter","zh":"与服务员互动"}]},{"id":"U12-W42","lemma":"significantly","surface":"significantly","pos":"adv.","zh":"显著地; 重大地","sent":"U12-P4-S3","phrases":[{"en":"significantly higher","zh":"显著更高"}]},{"id":"U12-W43","lemma":"positive","surface":"positive","pos":"adj.","zh":"积极的; 正面的; 肯定的","sent":"U12-P4-S3","phrases":[{"en":"positive feelings","zh":"积极情绪"},{"en":"positive attitude","zh":"积极的态度"}]},{"id":"U12-W44","lemma":"feeling","surface":"feelings","pos":"n.","zh":"感觉; 情绪; 感情","sent":"U12-P4-S3","phrases":[{"en":"positive feelings","zh":"积极情绪"},{"en":"mixed feelings","zh":"复杂的感情"}]},{"id":"U12-W45","lemma":"peripheral","surface":"peripheral","pos":"adj.","zh":"边缘的; 外围的","sent":"U12-P4-S5","phrases":[{"en":"peripheral members","zh":"边缘成员"}]},{"id":"U12-W46","lemma":"network","surface":"network","pos":"n. / v.","zh":"n. 网络; 关系网 v. 建立关系网","sent":"U12-P4-S5","phrases":[{"en":"social network","zh":"社交网络"},{"en":"social networking","zh":"社交网络活动"}]},{"id":"U12-W47","lemma":"matter","surface":"matter","pos":"v. / n.","zh":"v. 重要; 有关系 n. 事情; 物质","sent":"U12-P4-S5","phrases":[{"en":"it doesn't matter","zh":"没关系"},{"en":"what's the matter","zh":"怎么了"}]},{"id":"U12-W48","lemma":"well-being","surface":"well-being","pos":"n.","zh":"幸福感; 安康; 福利","sent":"U12-P4-S5","phrases":[{"en":"sense of well-being","zh":"幸福感"},{"en":"promote well-being","zh":"促进幸福感"}]},{"id":"U12-W49","lemma":"reach","surface":"reach","pos":"v. / n.","zh":"v. 伸出; 到达; 联系 n. 范围; 伸手可及的距离","sent":"U12-P5-S1","phrases":[{"en":"reach out to","zh":"主动联系; 向...伸出援手"}]},{"id":"U12-W50","lemma":"belonging","surface":"belonging","pos":"n.","zh":"归属感; 所属物","sent":"U12-P5-S1","phrases":[{"en":"sense of belonging","zh":"归属感"}]},{"id":"U12-W51","lemma":"bond","surface":"bond","pos":"n. / v.","zh":"n. 纽带; 联结; 债券 v. 建立联系","sent":"U12-P5-S1","phrases":[{"en":"a bond with others","zh":"与他人的联结"},{"en":"form a bond","zh":"建立纽带"}]},{"id":"U12-W52","lemma":"basis","surface":"basis","pos":"n.","zh":"基础; 根据","sent":"U12-P5-S3","phrases":[{"en":"on the basis of","zh":"在...的基础上"},{"en":"the basis of","zh":"...的基础"}]},{"id":"U12-W53","lemma":"manner","surface":"manners","pos":"n.","zh":"礼仪; 礼貌; 方式","sent":"U12-P5-S3","phrases":[{"en":"good manners","zh":"良好礼仪"},{"en":"bad manners","zh":"不礼貌"}]}],"_v":1786413566727}