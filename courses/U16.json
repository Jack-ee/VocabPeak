a":"organism","surface":"organisms","pos":"n.","zh":"生物体; 有机体; 微生物","sent":"U16-P6-S3","phrases":[{"en":"put organisms","zh":"放入生物体"}]},{"id":"U16-W50","lemma":"system","surface":"systems","pos":"n.","zh":"系统; 体系; 制度","sent":"U16-P6-S4","phrases":[{"en":"new systems","zh":"新系统"}]},{"id":"U16-W51","lemma":"self-repair","surface":"self-repair","pos":"n. / v.","zh":"自我修复; 自修","sent":"U16-P6-S4","phrases":[{"en":"develop self-repair","zh":"发展自我修复"}]}],"_v":1786413566727}